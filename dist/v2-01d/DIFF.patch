+param([switch]$Preview)
+$ErrorActionPreference='Stop'
+$projectRoot=Split-Path -Parent $PSScriptRoot
+Push-Location $projectRoot
+try {
+    New-Item -ItemType Directory -Force evidence/v2-01d | Out-Null
+    & tools/select-test-monitor.ps1 -OutputPath evidence/v2-01d/monitor.json
+    & tools/build-monitor-agent.ps1
+    if($LASTEXITCODE -ne 0){throw 'Monitor launcher build failed'}
+    $env:GRADLE_USER_HOME=Join-Path (Split-Path -Parent $projectRoot) 'gradle-home'
+    $task=if($Preview){'runV2TownPreview'}else{'runV2PlayableManual'}
+    & .\gradlew.bat --offline --no-daemon --init-script tools/ci/v2-playable-manual.init.gradle $task --console=plain
+    $result=$LASTEXITCODE
+} finally { Pop-Location }
+exit $result
diff --git a/tools/validation/test_v2_01_client_evidence.py b/tools/validation/test_v2_01_client_evidence.py
new file mode 100644
index 0000000..55978fa
--- /dev/null
+++ b/tools/validation/test_v2_01_client_evidence.py
@@ -0,0 +1,178 @@
+"""Synthetic validator tests. These results are not real-client evidence."""
+import contextlib
+import copy
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+import v2_01_client_evidence as validator
+
+
+class EvidenceTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.source = self.root / "session.json"
+        self.output = self.root / "summary.json"
+        (self.root / "run.log").write_text("SYNTHETIC SELF-TEST ONLY", encoding="utf-8")
+        self.document = {"schema": 1, "evidence_mode": "SYNTHETIC", "scenarios": [self.row(n) for n in validator.SCENARIOS]}
+        self.save()
+
+    def row(self, name):
+        return {"scenario": name, "result": "PASS", "build_sha": "a" * 40, "jar_sha256": "b" * 64,
+                "isolated_profile": "synthetic-profile", "start_condition": "synthetic start",
+                "observed_behavior": "synthetic observation", "expected_behavior": "synthetic expectation",
+                "evidence_reference": ["run.log"], "tester": "validator self-test", "tester_kind": "AUTOMATED", "notes": ""}
+
+    def save(self):
+        self.source.write_text(json.dumps(self.document), encoding="utf-8")
+
+    def summary(self):
+        self.save()
+        return validator.summarize(self.document, self.source, self.output)
+
+    def reject(self, fragment):
+        with self.assertRaisesRegex(validator.InvalidEvidence, fragment):
+            self.summary()
+
+    def test_missing_scenarios_are_not_tested(self):
+        self.document["scenarios"] = []
+        result = self.summary()
+        self.assertEqual(result["counts"], {"NOT_TESTED": 15})
+        self.assertEqual(result["V2_01_CLIENT_GATE"], "PARTIAL")
+        self.assertEqual(result["REAL_CLIENT"], "NOT_TESTED")
+
+    def test_synthetic_pass_never_becomes_client_pass(self):
+        result = self.summary()
+        self.assertEqual(result["reported_evidence_gate"], "PASS")
+        self.assertEqual(result["V2_01_CLIENT_GATE"], "PARTIAL")
+        self.assertEqual(result["HUMAN_EXPERIENCE"], "NOT_TESTED")
+
+    def test_real_client_template_without_executed_rows_is_not_tested(self):
+        self.document["evidence_mode"] = "REAL_CLIENT"
+        for row in self.document["scenarios"]:
+            row["result"] = "NOT_TESTED"
+        result = self.summary()
+        self.assertEqual(result["REAL_CLIENT"], "NOT_TESTED")
+        self.assertEqual(result["V2_01_CLIENT_GATE"], "PARTIAL")
+
+    def test_executed_real_client_evidence_retains_partial_status(self):
+        self.document["evidence_mode"] = "REAL_CLIENT"
+        self.document["scenarios"] = self.document["scenarios"][:1]
+        self.assertEqual(self.summary()["REAL_CLIENT"], "PARTIAL")
+
+    def test_every_must_failure_blocks_gate(self):
+        for name in validator.MUST:
+            doc = copy.deepcopy(self.document)
+            next(row for row in doc["scenarios"] if row["scenario"] == name)["result"] = "FAIL"
+            result = validator.summarize(doc, self.source, self.output)
+            self.assertEqual(result["reported_evidence_gate"], "FAIL", name)
+
+    def test_blocked_and_not_tested_must_remain_partial(self):
+        for status in ("BLOCKED", "NOT_TESTED"):
+            self.document["scenarios"][0]["result"] = status
+            self.assertEqual(self.summary()["reported_evidence_gate"], "PARTIAL")
+
+    def test_optional_failure_does_not_override_required_gate(self):
+        next(r for r in self.document["scenarios"] if r["scenario"] == "yeoul_daily_route")["result"] = "FAIL"
+        self.assertEqual(self.summary()["reported_evidence_gate"], "PASS")
+
+    def test_duplicate_and_unknown_scenarios_rejected(self):
+        self.document["scenarios"].append(copy.deepcopy(self.document["scenarios"][0]))
+        self.reject("DUPLICATE_SCENARIO")
+        self.document["scenarios"][-1]["scenario"] = "imagined_success"
+        self.reject("UNKNOWN_SCENARIO")
+
+    def test_invalid_result_rejected(self):
+        self.document["scenarios"][0]["result"] = "probably PASS"
+        self.reject("INVALID_RESULT")
+
+    def test_metadata_required_for_executed_scenario(self):
+        for field in (*validator.TEXT_FIELDS, "build_sha", "jar_sha256", "tester_kind", "isolated_profile"):
+            with self.subTest(field=field):
+                row = self.document["scenarios"][0]
+                old = row.pop(field)
+                self.reject("MISSING|INVALID")
+                row[field] = old
+
+    def test_mixed_build_or_jar_rejected(self):
+        for field, length in (("build_sha", 40), ("jar_sha256", 64)):
+            old = self.document["scenarios"][0][field]
+            self.document["scenarios"][0][field] = "c" * length
+            self.reject("MIXED_BUILD_EVIDENCE")
+            self.document["scenarios"][0][field] = old
+
+    def test_automatic_human_result_rejected(self):
+        self.document["evidence_mode"] = "REAL_CLIENT"
+        for field in validator.HUMAN_FIELDS:
+            self.document["scenarios"][0][field] = "PASS"
+            self.reject("HUMAN_RESULT_WITHOUT_HUMAN_RUN")
+            del self.document["scenarios"][0][field]
+
+    def test_synthetic_human_claim_rejected(self):
+        self.document["scenarios"][0].update(tester_kind="HUMAN", human_readability="PASS")
+        self.reject("HUMAN_RESULT_WITHOUT_HUMAN_RUN")
+
+    def test_human_rollup_requires_every_must(self):
+        self.document["evidence_mode"] = "REAL_CLIENT"
+        for row in self.document["scenarios"]:
+            row.update(tester_kind="HUMAN", human_readability="PASS")
+        self.assertEqual(self.summary()["HUMAN_EXPERIENCE"], "PASS")
+        self.document["scenarios"][0]["human_readability"] = "NOT_TESTED"
+        self.assertEqual(self.summary()["HUMAN_EXPERIENCE"], "NOT_TESTED")
+        self.document["scenarios"][0]["human_readability"] = "FAIL"
+        self.assertEqual(self.summary()["HUMAN_EXPERIENCE"], "FAIL")
+
+    def test_reference_existence_and_hash(self):
+        result = self.summary()
+        ref = result["scenarios"][0]["verified_references"][0]
+        self.assertEqual(ref["size"], len("SYNTHETIC SELF-TEST ONLY"))
+        self.assertEqual(len(ref["sha256"]), 64)
+        self.document["scenarios"][0]["evidence_reference"] = ["missing.log"]
+        self.reject("INVALID_REFERENCE_TARGET")
+
+    def test_reference_escape_and_input_output_rejected(self):
+        for reference in (str(self.source), str(self.output), "../outside.log"):
+            self.document["scenarios"][0]["evidence_reference"] = [reference]
+            self.reject("INVALID_REFERENCE_TARGET")
+
+    def test_pass_requires_evidence(self):
+        self.document["scenarios"][0]["evidence_reference"] = []
+        self.reject("MISSING_EVIDENCE")
+
+    def test_duplicate_json_key_rejected(self):
+        self.source.write_text('{"schema":1,"schema":1}', encoding="utf-8")
+        with contextlib.redirect_stdout(io.StringIO()) as output:
+            code = validator.main([str(self.source), str(self.output)])
+        self.assertEqual(code, 2)
+        self.assertIn("DUPLICATE_JSON_KEY", output.getvalue())
+
+    def test_invalid_input_preserves_existing_output(self):
+        self.output.write_text("KEEP", encoding="utf-8")
+        self.document["schema"] = 99;self.save()
+        with contextlib.redirect_stdout(io.StringIO()):
+            code = validator.main([str(self.source), str(self.output)])
+        self.assertEqual(code, 2)
+        self.assertEqual(self.output.read_text(), "KEEP")
+
+    def test_cli_partial_exit_and_input_preservation(self):
+        self.document["scenarios"] = [];self.save();before=self.source.read_bytes()
+        with contextlib.redirect_stdout(io.StringIO()):
+            code = validator.main([str(self.source), str(self.output)])
+        self.assertEqual(code, 1)
+        self.assertEqual(self.source.read_bytes(), before)
+        self.assertEqual(json.loads(self.output.read_text())["counts"]["NOT_TESTED"], 15)
+
+    def test_cli_same_file_rejected(self):
+        before = self.source.read_bytes()
+        with contextlib.redirect_stdout(io.StringIO()):
+            code = validator.main([str(self.source), str(self.source)])
+        self.assertEqual(code, 2)
+        self.assertEqual(self.source.read_bytes(), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tools/validation/test_v2_01_client_log_draft.py b/tools/validation/test_v2_01_client_log_draft.py
new file mode 100644
index 0000000..e6c84ba
--- /dev/null
+++ b/tools/validation/test_v2_01_client_log_draft.py
@@ -0,0 +1,98 @@
+"""Synthetic log ingestion tests. These tests do not execute Minecraft."""
+import contextlib
+import hashlib
+import io
+import json
+from pathlib import Path
+import tempfile
+import unittest
+
+import v2_01_client_evidence as validator
+import v2_01_client_log_draft as draft
+
+
+class LogDraftTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.root = Path(self.temp.name)
+        self.log = self.root / "client.log"
+        self.output = self.root / "draft"
+        self.raw = (b"[12:00:00] [Render thread/INFO] [minecraft/SoundEngine]: Sound engine started\r\n"
+                    b"BUILD SUCCESSFUL\r\nAll scenarios PASS; human audio PASS\r\n")
+        self.log.write_bytes(self.raw)
+
+    def test_success_markers_and_claim_text_never_grant_acceptance(self):
+        review = draft.prepare(self.log, self.output)
+        self.assertFalse(review["inferred_acceptance"])
+        self.assertEqual(review["markers"]["gradle_success"]["count"], 1)
+        session = json.loads((self.output / "client-session.json").read_text())
+        summary = validator.summarize(session, self.output / "client-session.json", self.output / "summary.json")
+        self.assertEqual(summary["counts"], {"NOT_TESTED": 15})
+        self.assertEqual(summary["REAL_CLIENT"], "NOT_TESTED")
+        self.assertEqual(summary["HUMAN_EXPERIENCE"], "NOT_TESTED")
+
+    def test_source_copy_is_byte_exact_and_source_is_unchanged(self):
+        review = draft.prepare(self.log, self.output)
+        self.assertEqual((self.output / "references/source.log").read_bytes(), self.raw)
+        self.assertEqual(self.log.read_bytes(), self.raw)
+        self.assertEqual(review["source_sha256"], hashlib.sha256(self.raw).hexdigest())
+
+    def test_target_jar_is_measured_but_never_attached_to_unexecuted_rows(self):
+        jar = self.root / "candidate.jar"
+        jar.write_bytes(b"SYNTHETIC JAR FIXTURE")
+        review = draft.prepare(self.log, self.output, "planned-profile", "a" * 40, jar)
+        self.assertEqual(review["target_build"]["jar_sha256"], hashlib.sha256(jar.read_bytes()).hexdigest())
+        session = json.loads((self.output / "client-session.json").read_text())
+        self.assertTrue(all(row["build_sha"] is None and row["jar_sha256"] is None for row in session["scenarios"]))
+
+    def test_existing_output_is_preserved(self):
+        self.output.mkdir()
+        sentinel = self.output / "keep.txt"
+        sentinel.write_text("KEEP")
+        with self.assertRaisesRegex(ValueError, "OUTPUT_ALREADY_EXISTS"):
+            draft.prepare(self.log, self.output)
+        self.assertEqual(sentinel.read_text(), "KEEP")
+        self.assertEqual(len(list(self.output.iterdir())), 1)
+
+    def test_missing_log_does_not_publish(self):
+        with self.assertRaises(OSError):
+            draft.prepare(self.root / "missing.log", self.output)
+        self.assertFalse(self.output.exists())
+
+    def test_target_pair_and_hash_are_validated_before_publication(self):
+        for build, jar in (("a" * 40, None), (None, self.log), ("bad", self.log)):
+            with self.subTest(build=build, jar=jar), self.assertRaises(ValueError):
+                draft.prepare(self.log, self.output, build_sha=build, jar=jar)
+            self.assertFalse(self.output.exists())
+
+    def test_server_log_does_not_prove_client_execution(self):
+        self.log.write_text("Preparing start region for dimension minecraft:overworld\nPlayer joined the game\n")
+        review = draft.prepare(self.log, self.output)
+        self.assertEqual(review["source_kind"], "UNCLASSIFIED_LOG")
+        self.assertEqual(review["markers"]["player_join"]["count"], 1)
+        self.assertFalse(review["inferred_acceptance"])
+
+    def test_kernel_failure_is_only_a_log_marker(self):
+        self.log.write_text("failed to write kernel assets: os error 3\n")
+        review = draft.prepare(self.log, self.output)
+        self.assertEqual(review["markers"]["error_or_kernel_failure"]["count"], 1)
+        session = json.loads((self.output / "client-session.json").read_text())
+        self.assertTrue(all(row["result"] == "NOT_TESTED" for row in session["scenarios"]))
+
+    def test_non_utf8_log_keeps_original_hash(self):
+        self.log.write_bytes(b"\xff\xfe\x00\r\n")
+        review = draft.prepare(self.log, self.output)
+        self.assertEqual(review["source_sha256"], hashlib.sha256(self.log.read_bytes()).hexdigest())
+
+    def test_cli_reports_draft_success_and_repeat_failure(self):
+        with contextlib.redirect_stdout(io.StringIO()) as output:
+            first = draft.main([str(self.log), str(self.output)])
+            second = draft.main([str(self.log), str(self.output)])
+        self.assertEqual((first, second), (0, 2))
+        self.assertIn("REAL_CLIENT=NOT_TESTED", output.getvalue())
+        self.assertIn("OUTPUT_ALREADY_EXISTS", output.getvalue())
+
+
+if __name__ == "__main__":
+    unittest.main()
