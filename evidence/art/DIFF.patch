+        PacketDistributor.sendToPlayer(p,new ScenePayload(3,STAGE));return true;
+    }
+    @SubscribeEvent public void tick(PlayerTickEvent.Post event) {
+        if(event.getEntity() instanceof ServerPlayer p&&p.tickCount%20==0)tryStart(p);
+    }
+}
