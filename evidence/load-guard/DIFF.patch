+            s.status.saveFormat,s.status.actorSchema,s.status.actorCount,false,s.status.originalHash,"LOAD_CORRUPT_BLOCKED write_guard_poisoned");
+        return s.status;
+    }
+
+    public static synchronized NarrativeData open(DimensionDataStorage storage,Path directory,HolderLookup.Provider registry,Set<String> dimensions) {
