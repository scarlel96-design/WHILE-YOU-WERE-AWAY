+plugins {
+    id 'java-library'
+    id 'net.neoforged.moddev' version '2.0.146'
+}
+version = mod_version
+group = 'io.github.whileaway'
+base { archivesName = 'whileaway' }
+java { toolchain.languageVersion = JavaLanguageVersion.of(21) }
+repositories {
+    mavenCentral()
+    maven { url = 'https://dl.cloudsmith.io/public/geckolib3/geckolib/maven/'; content { includeGroup('software.bernie.geckolib') } }
+}
+dependencies {
+    implementation "software.bernie.geckolib:geckolib-neoforge-1.21.1:${geckolib_version}"
+    testImplementation 'org.junit.jupiter:junit-jupiter:5.11.4'
+    testRuntimeOnly 'org.junit.platform:junit-platform-launcher:1.11.4'
+}
+tasks.named('test') { useJUnitPlatform() }
+neoForge {
+    version = neo_version
+    runs {
+        client { client() }
+        clientSmoke {
+            client()
+            gameDirectory = file('../../work/client-smoke')
+            systemProperty 'whileaway.clientSmoke', 'true'
+            systemProperty 'whileaway.evidence', file('evidence').absolutePath
+        }
+        citySmoke {
+            client()
+            gameDirectory = file('../../work/city-smoke')
+            systemProperty 'whileaway.citySmoke', 'true'
+            systemProperty 'whileaway.evidence', file('evidence/stability/regression').absolutePath
+            systemProperty 'whileaway.artSmoke', 'true'
+        }
+        cityReload {
+            client()
+            gameDirectory = file('../../work/city-smoke')
+            systemProperty 'whileaway.citySmoke', 'true'
+            systemProperty 'whileaway.cityReload', 'true'
+            systemProperty 'whileaway.evidence', file('evidence/stability/regression').absolutePath
+            systemProperty 'whileaway.artSmoke', 'true'
+        }
+        [1,2].each { repetition ->
+            ['Cut','Copy','Resume'].each { mode ->
+                create("recovery${mode}${repetition}") {
+                    client()
+                    gameDirectory = file('../../work/recovery-smoke')
+                    systemProperty 'whileaway.recovery', mode == 'Cut' ? 'cut' : mode == 'Copy' ? 'copy' : 'resume'
+                    systemProperty 'whileaway.recoveryTask', "runRecovery${mode}${repetition}"
+                    systemProperty 'whileaway.repeat', repetition.toString()
+                    systemProperty 'whileaway.evidence', file('evidence/stability').absolutePath
+                }
+            }
+        }
+        [1,2,4].each { kind ->
+            def steps = kind == 4 ? ['A','B','D','E','Verify'] : ['D','E','Verify']
+            steps.each { boundary ->
+            create("boundary${kind}${boundary}") {
+                client()
+                gameDirectory = file('../../work/boundary-smoke')
+                systemProperty 'whileaway.boundary', boundary
+                systemProperty 'whileaway.boundaryKind', kind.toString()
+                systemProperty 'whileaway.evidence', file('evidence/reuse').absolutePath
+            }
+        } }
+        recoveryLegacy {
+            client()
+            gameDirectory = file('../../work/recovery-smoke')
+            systemProperty 'whileaway.recovery', 'legacy'
+            systemProperty 'whileaway.recoveryTask', 'runRecoveryLegacy'
+            systemProperty 'whileaway.evidence', file('evidence/stability').absolutePath
+        }
+        server { server(); programArgument '--nogui' }
+        gameTestServer { type = 'gameTestServer'; systemProperty 'neoforge.enabledGameTestNamespaces', 'whileaway' }
+    }
+    mods { whileaway { sourceSet sourceSets.main } }
+}
+tasks.withType(JavaCompile).configureEach { options.encoding = 'UTF-8' }
+tasks.named('processResources') {
+    inputs.property 'version', project.version
+    filesMatching('META-INF/neoforge.mods.toml') { expand version: project.version }
+}
+tasks.register('coreTest', JavaExec) {
+    dependsOn testClasses
+    classpath = sourceSets.test.runtimeClasspath
+    mainClass = 'io.github.whileaway.core.CoreTests'
+}
+tasks.named('check') { dependsOn 'coreTest' }
+tasks.withType(Jar).configureEach { preserveFileTimestamps = false; reproducibleFileOrder = true }
+
+// Developer clients are muted BEFORE launch, including the title/onboarding screens.
+// Only isolated development options are changed, never the user's normal .minecraft profile.
+['runClient': file('run'), 'runClientSmoke': file('../../work/client-smoke'), 'runCitySmoke':file('../../work/city-smoke'),'runCityReload':file('../../work/city-smoke')].each { taskName, gameDir ->
+    tasks.named(taskName).configure {
+        doFirst {
+            gameDir.mkdirs()
+            def options = new File(gameDir, 'options.txt')
+            def lines = options.exists() ? options.readLines('UTF-8') : []
+            def overrides = ['soundCategory_master':'0.0','soundCategory_music':'0.0',
+                'soundCategory_record':'0.0','soundCategory_weather':'0.0','soundCategory_block':'0.0',
+                'soundCategory_hostile':'0.0','soundCategory_neutral':'0.0','soundCategory_player':'0.0',
+                'soundCategory_ambient':'0.0','soundCategory_voice':'0.0','narrator':'0',
+                'onboardAccessibility':'false','tutorialStep':'none','pauseOnLostFocus':'false']
+            lines.removeAll { line -> overrides.containsKey(line.split(':', 2)[0]) }
+            if (taskName != 'runClient') { lines.removeAll { it.startsWith('lang:') || it.startsWith('renderDistance:') || it.startsWith('simulationDistance:') }; lines.add('lang:ko_kr') }
+            overrides.each { k,v -> lines.add("${k}:${v}") }
+            options.setText(lines.join('\n')+'\n','UTF-8')
+            if (!options.text.contains('soundCategory_master:0.0')) throw new GradleException('Prelaunch mute verification failed')
+            logger.lifecycle("VERIFIED MUTED before launch: ${options.absolutePath}")
+            if (taskName == 'runClientSmoke') file('evidence/client-smoke.txt').setText('RUNNING: awaiting client checks\n', 'UTF-8')
+            if (taskName.startsWith('runCity')) file('evidence/stability/regression/'+taskName+'.txt').setText('RUNNING\n','UTF-8')
+        }
+        if (taskName.startsWith('runCity')) {
+            doLast {
+                if(!file('evidence/stability/regression/'+taskName+'.txt').getText('UTF-8').contains('PASS '+taskName))
+                    throw new GradleException('City client did not finish every gate')
+            }
+        }
+        if (taskName == 'runClientSmoke') {
+            doLast {
+                def evidence = file('evidence/client-smoke.txt').getText('UTF-8')
+                if (!evidence.contains('PASS tracked custom entity present with camera line of sight') ||
+                    !evidence.contains('PASS scene S2C starts, reaches caption phase and ends; master volume remains zero')) {
+                    throw new GradleException('Client smoke did not reach every required gate; inspect runtime log')
+                }
+            }
+        }
+    }
+}
+
+// Fault-injection clients use the same prelaunch mute implementation as every other test client.
+['Cut','Copy','Resume'].each { mode -> (1..2).each { repetition ->
+    tasks.named("runRecovery${mode}${repetition}").configure {
+        if(mode == 'Cut') ignoreExitValue = true
+        doFirst {
+            def gameDir=file('../../work/recovery-smoke');gameDir.mkdirs()
+            def options=new File(gameDir,'options.txt')
+            def lines=options.exists()?options.readLines('UTF-8'):[]
+            def muted=['master','music','record','weather','block','hostile','neutral','player','ambient','voice']
+            lines.removeAll { it.startsWith('soundCategory_') || it.startsWith('narrator:') || it.startsWith('onboardAccessibility:') || it.startsWith('tutorialStep:') || it.startsWith('pauseOnLostFocus:') || it.startsWith('lang:') || it.startsWith('renderDistance:') || it.startsWith('simulationDistance:') }
+            muted.each { lines.add("soundCategory_${it}:0.0") }
+            lines.addAll(['narrator:0','onboardAccessibility:false','tutorialStep:none','pauseOnLostFocus:false','lang:ko_kr','renderDistance:8','simulationDistance:5'])
+            options.setText(lines.join('\n')+'\n','UTF-8')
+            if(!muted.every { options.text.contains("soundCategory_${it}:0.0") })throw new GradleException('Recovery mute failed')
+            logger.lifecycle("VERIFIED MUTED before launch: ${options.absolutePath}")
+            file("evidence/stability/runRecovery${mode}${repetition}.txt").setText('RUNNING\n','UTF-8')
+        }
+        doLast {
+            if(mode == 'Cut') logger.lifecycle("EXPECTED_FAULT_PROCESS_EXIT=${executionResult.get().exitValue}")
+            if(!file("evidence/stability/runRecovery${mode}${repetition}.txt").text.contains("PASS runRecovery${mode}${repetition}"))throw new GradleException('Recovery fault gate did not finish')
+        }
+    }
+} }
+
+tasks.named('runRecoveryLegacy').configure {
+    doFirst {
+        def options=file('../../work/recovery-smoke/options.txt')
+        // Reuse only the already isolated profile, and re-verify ALL sound categories before this launch.
+        if(!options.exists() || !['master','music','record','weather','block','hostile','neutral','player','ambient','voice'].every { options.text.contains("soundCategory_${it}:0.0") } || !options.text.contains('narrator:0'))throw new GradleException('Legacy mute gate failed')
+        logger.lifecycle("VERIFIED MUTED before launch: ${options.absolutePath}")
+        file('evidence/stability/runRecoveryLegacy.txt').setText('RUNNING\n','UTF-8')
+    }
+    doLast { if(!file('evidence/stability/runRecoveryLegacy.txt').text.contains('PASS runRecoveryLegacy'))throw new GradleException('Legacy migration gate failed') }
+}
+
+// New evidence and profile: adopted 0.3.1 fixtures are never overwritten.
+[1,2,4].each { kind ->
+            def steps = kind == 4 ? ['A','B','D','E','Verify'] : ['D','E','Verify']
+            steps.each { boundary ->
+    tasks.named("runBoundary${kind}${boundary}").configure {
+        if(boundary!='Verify') ignoreExitValue=true
+        doFirst {
+            def dir=file('../../work/boundary-smoke');dir.mkdirs()
+            def muted=['master','music','record','weather','block','hostile','neutral','player','ambient','voice']
+            def values=muted.collect { "soundCategory_${it}:0.0" }
+            values.addAll(['narrator:0','onboardAccessibility:false','tutorialStep:none','pauseOnLostFocus:false','lang:ko_kr','renderDistance:8','simulationDistance:5'])
